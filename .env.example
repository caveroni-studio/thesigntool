# --- Stripe (test mode keys shown; swap for live keys in production) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs created by `npm run stripe:setup` (or the Dashboard steps in README.md)
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...
STRIPE_PRICE_TEAM_YEARLY=price_...
TEAM_MIN_SEATS=3

# --- Database (any Postgres works: Supabase, Neon, Vercel Postgres, Railway...) ---
# Use a pooled/serverless-friendly connection string in production.
DATABASE_URL=postgres://user:password@host:5432/thesigntool

# --- App / CORS ---
# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=https://thesigntool.com,http://localhost:5500
# Where Stripe Checkout / Billing Portal / OAuth logins should send the browser back
# to. Must also be the exact origin the frontend is served from (same-site deploy).
FRONTEND_URL=https://thesigntool.com

# --- Auth ---
# Long random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google OAuth (Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# > Web application). Authorized redirect URI: {FRONTEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (Azure Portal > App registrations > New registration, "common"
# multi-tenant). Redirect URI: {FRONTEND_URL}/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

PORT=3000
